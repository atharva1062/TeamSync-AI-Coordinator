# Create a bot with Telegram's @BotFather and paste its token locally.
TELEGRAM_BOT_TOKEN=
# Your private chat ID from /start. Only this user can trigger /followup.
COORDINATOR_CHAT_ID=
# Relative paths are resolved from the project folder.
DATABASE_PATH=data/coordinator.sqlite3
# Blank key keeps reply collection active but disables AI updates.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TELEGRAM_BOT_USERNAME=TeamSyncCoordinatorBot
# Read-only GitHub API access: higher quota for public repos; required for private repos.
# Use a fine-grained token limited to the project repo, Contents: Read-only (Metadata included).
# Save in .env only. Adding a missing token is detected automatically; restart after rotating an existing token.
GITHUB_TOKEN=
# Admin portal setup: store only a Werkzeug password hash in .env.
# ADMIN_USERNAME=Hellix_04
# ADMIN_PASSWORD_HASH=generate-a-Werkzeug-password-hash-before-deployment
# Retained for switching back with AI_PROVIDER=claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
